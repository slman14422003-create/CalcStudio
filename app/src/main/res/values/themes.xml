<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="cAccent">@color/accent</item>
        <item name="cAccentText">@color/accent_text</item>
        <item name="cAccentSoft">@color/accent_soft</item>
        <item name="cBg">@color/bg</item>
        <item name="cCalcBg">@color/calc_bg</item>
        <item name="cGroupBg">@color/bg_group</item>
        <item name="cSurface">@color/surface</item>
        <item name="cSurfaceHigh">@color/surface_high</item>
        <item name="cField">@color/field</item>
        <item name="cStroke">@color/stroke</item>
        <item name="cStrokeSoft">@color/stroke_soft</item>
        <item name="cTextPrimary">@color/text_primary</item>
        <item name="cTextSecondary">@color/text_secondary</item>
        <item name="cTextHint">@color/text_hint</item>
        <item name="cNeutralSoft">@color/neutral_soft</item>
        <item name="cKeyDigit">@color/key_digit</item>
        <item name="cKeyFunction">@color/key_function</item>
        <item name="cKeyOperator">@color/key_operator</item>
        <item name="colorPrimary">?attr/cAccent</item>
        <item name="colorPrimaryDark">?attr/cBg</item>
        <item name="colorAccent">?attr/cAccentText</item>
        <item name="android:windowBackground">?attr/cBg</item>
        <item name="android:statusBarColor">?attr/cBg</item>
        <item name="android:navigationBarColor">?attr/cBg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorEdgeEffect">?attr/cTextHint</item>
        <item name="android:textColorPrimary">?attr/cTextPrimary</item>
        <item name="android:textColorSecondary">?attr/cTextSecondary</item>
        <item name="android:textColorHint">?attr/cTextHint</item>
        <item name="alertDialogTheme">@style/AppDialog</item>
        <item name="android:colorBackground">?attr/cBg</item>
        <item name="android:windowAnimationStyle">@style/AppWindowAnim</item>
        <item name="colorControlNormal">?attr/cTextSecondary</item>
        <item name="colorControlActivated">?attr/cAccentText</item>
    </style>

    <style name="AppDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">?attr/cAccentText</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">?attr/cTextPrimary</item>
        <item name="android:textColorSecondary">?attr/cTextSecondary</item>
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:textSize">16sp</item>
        <item name="alertDialogStyle">@style/AppAlertDialog</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButtonSoft</item>
        <item name="buttonBarButtonStyle">@style/AppDialogButtonSoft</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/AppDialogButtonPrimary</item>
        <item name="buttonBarPositiveButtonStyle">@style/AppDialogButtonPrimary</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AppDialogButtonSoft</item>
        <item name="buttonBarNegativeButtonStyle">@style/AppDialogButtonSoft</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/AppDialogButtonSoft</item>
        <item name="buttonBarNeutralButtonStyle">@style/AppDialogButtonSoft</item>
        <item name="windowMinWidthMinor">84%</item>
        <item name="windowMinWidthMajor">56%</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowAnimationStyle">@style/AppDialogAnim</item>
    </style>

    <style name="AppAlertDialog" parent="AlertDialog.AppCompat">
        <item name="singleChoiceItemLayout">@layout/item_dialog_choice</item>
    </style>

    <style name="AppDialogTitleText" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/cTextPrimary</item>
    </style>

    <style name="AppDialogTitle">
        <item name="android:textAppearance">@style/AppDialogTitleText</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AppDialogButtonSoft" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">?attr/cAccentText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/bg_dialog_btn_soft</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="AppDialogButtonPrimary" parent="AppDialogButtonSoft">
        <item name="android:textColor">?attr/cAccentText</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/bg_dialog_btn_primary</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:tint">?attr/cTextPrimary</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="KeyBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="KeyDigit" parent="KeyBase">
        <item name="android:background">@drawable/key_digit_bg</item>
        <item name="android:textColor">@color/key_digit_text</item>
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="KeyFunction" parent="KeyBase">
        <item name="android:background">@drawable/key_function_bg</item>
        <item name="android:textColor">@color/key_function_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="KeyOperator" parent="KeyBase">
        <item name="android:background">@drawable/key_operator_bg</item>
        <item name="android:textColor">@color/key_operator_text</item>
        <item name="android:textSize">36sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="KeyEquals" parent="KeyBase">
        <item name="android:background">@drawable/key_equals_bg</item>
        <item name="android:textColor">@color/key_operator_text</item>
        <item name="android:textSize">36sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="KeyDanger" parent="KeyBase">
        <item name="android:background">@drawable/key_danger_bg</item>
        <item name="android:textColor">@color/key_function_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="AppWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/motion_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/motion_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/motion_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/motion_close_exit</item>
    </style>

    <style name="AppDialogAnim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/motion_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/motion_dialog_exit</item>
    </style>
</resources>
