<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="0" android:exitFadeDuration="450">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_digit_pressed" />
            <corners android:radius="200dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_digit" />
            <corners android:radius="200dp" />
        </shape>
    </item>
</selector>
